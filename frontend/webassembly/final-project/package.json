{
  "name": "wasm-multimedia-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:wasm": "npm run build:wasm:image && npm run build:wasm:audio && npm run build:wasm:compress",
    "build:wasm:image": "wasm-pack build crates/image-processor --target web --out-dir ../../src/wasm/pkg",
    "build:wasm:audio": "wasm-pack build crates/audio-processor --target web --out-dir ../../src/wasm/audio-pkg",
    "build:wasm:compress": "wasm-pack build crates/file-compressor --target web --out-dir ../../src/wasm/compress-pkg",
    "preview": "vite preview",
    "test": "vitest run",
    "test:bench": "vitest run --reporter=verbose tests/benchmark.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/",
    "check": "node scripts/check.cjs"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/runner": "^2.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}
