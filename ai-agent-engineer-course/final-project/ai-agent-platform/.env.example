# 后端环境变量
DATABASE_URL=postgresql+asyncpg://agent:agent123@postgres:5432/agent_platform
REDIS_URL=redis://:redis123@redis:6379/0
SECRET_KEY=change-me-to-a-random-string-in-production

# AI 模型 API Keys（填入你的真实 Key）
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# AI 模型 BASE_URL（可选，用于自定义 API 地址，如国内代理、私有部署等）
# 留空则使用官方默认地址
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 默认模型配置
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# 可观测性
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 数据库
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent123
POSTGRES_DB=agent_platform

# Redis
REDIS_PASSWORD=redis123

# Grafana
GRAFANA_PASSWORD=admin
